[Unit]
Description=CoreNest fixed-operation host management broker
Requires=corenest-control.socket
After=docker.service

[Service]
ExecStart=/usr/bin/python3 /opt/corenest/backend/control.py --config /etc/corenest/control.json
User=root
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectControlGroups=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
# Operator drop-in grants only the real LED sysfs directories on this board.
UMask=0077
