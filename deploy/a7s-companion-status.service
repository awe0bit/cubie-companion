[Unit]
Description=Export sanitized campus status for A7S Companion
After=a7s-campus-agent.service

[Service]
Type=oneshot
User=a7s-campus
Group=a7s-campus
ExecStart=/usr/bin/python3 -I /opt/a7s-companion/backend/export_status.py
RuntimeDirectory=a7s-companion-public
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
CapabilityBoundingSet=
MemoryMax=32M
TasksMax=8
UMask=0077
